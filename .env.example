# Public, build-time runner limits. These AGENT_* values are browser-visible.
AGENT_MAX_RUNTIME_SECONDS=1800
AGENT_COOLDOWN_SECONDS=43200
AGENT_STEP_INTERVAL_SECONDS=5
AGENT_PROVIDER_REQUEST_LIMIT=100
AGENT_MAX_CONSECUTIVE_ERRORS=5
AGENT_PROVIDER_DAILY_LIMIT=1000
AGENT_PROVIDER_TOKEN_LIMIT=500000

# Server-only Groq configuration. Never prefix the key with AGENT_ or VITE_.
GROQ_API_KEY=
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_MAX_OUTPUT_TOKENS=256

# Backend Runtime v1. Copy this file to .env for local development.
# In Vercel, set VITE_API_URL only if the dashboard should talk to a separately hosted backend.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_slavery
REDIS_URL=redis://localhost:6379
FRONTEND_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:4000

# Optional frontend persistence. Supabase takes precedence when both values exist.
# In Vercel, add these as Production and Preview environment variables.
# Use the Supabase anon/public key here, not the service-role secret.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

DRY_RUN_EXTERNAL_ACTIONS=true
ENABLE_WATCHERS=false
ENABLE_PLAYWRIGHT=false
